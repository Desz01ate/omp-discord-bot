# Dependencies
node_modules/
jspm_packages/
web_modules/

# Compiled output (Match your tsconfig.json outDir)
dist/
build/
out/
out-tsc/
*.tsbuildinfo

# Individual compiled JS files (Only use if compiling TS alongside JS files)
# *.js
# *.js.map
# *.d.ts

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data and test coverage
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage
.nyc_output

# Diagnostic reports (Next.js / Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Optional VS Code settings you might want to keep (uncomment to keep)
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
Thumbs.db

