DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Comma-separated list of Discord User IDs permitted to use the bot (REQUIRED for access).
# If empty or unset, all commands and messages are blocked by default (fail-closed).
# ALLOWED_USERS=123456789012345678,987654321098765432

# (Optional) Create private Discord threads by default for sessions (defaults to true).
# Set to false if you prefer standard public threads in guild text channels.
# CREATE_PRIVATE_THREADS=true

# --- Session Storage Configuration ---
# Storage backend for persisting session-to-thread bindings across bot restarts.
# Supported types: sqlite (default), memory
# SESSION_STORAGE_TYPE=sqlite
# Path to the SQLite database file inside container or local environment (defaults to data/sessions.sqlite)
# SQLITE_DB_PATH=data/sessions.sqlite
# Host directory for persisting bot data (sessions SQLite database) across container rebuilds
# HOST_DATA_PATH=./data
# --- Docker & Workspace Bind Mount Settings ---
# Path on host machine containing code repositories to mount into container (/workspace)
# Example: /home/user/Projects or /home/user/repos or ./workspace
HOST_WORKSPACE_PATH=./workspace

# Paths on host for persisting OMP & Pi configurations, sessions, and credentials
OMP_CONFIG_PATH=~/.omp
PI_CONFIG_PATH=~/.pi
CODEX_CONFIG_PATH=~/.codex
# Path on host for persisting mise runtime toolchains & caches (Go, Java, .NET, Rust, etc.)
HOST_MISE_DATA_PATH=~/.cache/omp-discord-bot/mise

# (Optional) Extra Debian system packages to install at build time without modifying Dockerfile
# Example: EXTRA_APT_PACKAGES=golang-go default-jdk
EXTRA_APT_PACKAGES=

# (Optional) Host directory with *.sh startup hooks executed on container launch
# HOST_INIT_HOOKS_PATH=./init.d


# Default base path inside the container (default: /workspace)
WORKSPACE_ROOT=/workspace

# --- LLM Provider API Keys & Gateways (passed to OMP/OMX) ---
# LITELLM_BASE_URL=http://192.168.1.18:4000/v1
# --- LLM Provider API Keys (passed to OMP/OMX) ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...

# --- Notification Hooks (Telegram, etc.) ---
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_USER_ID=...
